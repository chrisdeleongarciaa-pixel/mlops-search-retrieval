<?xml version="1.0" encoding="UTF-8"?>
<services version="1.0">
  <container id="default" version="1.0">
    <search />
    <document-api />
  </container>
  <content id="witness" version="1.0">
    <redundancy>1</redundancy>
    <documents>
      <document type="fragment" mode="index" />
      <document type="passage" mode="index" />
    </documents>
    <nodes>
      <node distribution-key="0" hostalias="node1" />
    </nodes>
    <tuning>
      <!-- MS MARCO holds 27 GB of float32 vectors: block feeding only close to the host's limits. -->
      <resource-limits>
        <memory>0.9</memory>
        <disk>0.9</disk>
      </resource-limits>
    </tuning>
  </content>
</services>
